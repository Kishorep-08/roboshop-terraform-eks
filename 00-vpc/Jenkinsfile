pipeline {
    agent {
        node {
            label 'agent-1'
        }
    }
    stages {
        stage ('init') {
            steps {
                withAWS(region:'us-east-1',credentials:'aws-auth') {
                    sh '''
                        cd 00-vpc
                        terraform init
                    '''
                }
                    
            }
        }
        stage ('plan') {
            steps {
                withAWS(region:'us-east-1',credentials:'aws-auth') {
                    sh '''
                         cd 00-vpc
                         terraform plan
                    '''
                }  
            }
        }
        stage ('apply') {
            steps {
                input (
                    message: 'Do you want to apply the changes?',
                    ok: 'Apply'
                )
                withAWS(region:'us-east-1',credentials:'aws-auth') {
                    sh '''
                        cd 00-vpc
                        terraform apply -auto-approve
                    '''
                }
            }
        }
        stage ('10-sg') {
            steps {
                script {
                    build job: '10-sg',
                    wait: true,  // waits for the completion of first job before starting this job
                    propogate: false 
                }
            }
        }
    }
}